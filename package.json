{
  "name": "growx-loc",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "deploy:api": "bun --cwd apps/api run deploy",
    "test:acceptance": "bun scripts/test-acceptance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.11"
}
