{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "growx-location-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.location.growxlabs.tech",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "REFERENCE_DB",
      "database_name": "growx-location-reference",
      "database_id": "4db529a7-a487-4a41-9ae3-3a288f4d4270"
    }
  ],
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SECRET_KEY",
      "SUPABASE_GLOBAL_URL",
      "SUPABASE_GLOBAL_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
